# =============================================================
# OpenStudio-Agent 环境变量配置
# 复制此文件为 .env 并填入你自己的 API Keys
# =============================================================

# ---------- AI 模型 ----------
# OpenAI API Key (用于 GPT-4o / GPT-4.1 等)
OPENAI_API_KEY=sk-your-key-here

# Anthropic Claude API Key (用于 Claude Sonnet / Opus)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# DeepSeek API Key (可选，性价比备选)
DEEPSEEK_API_KEY=sk-your-key-here

# ---------- 知识库 & 数据库 ----------
# Notion Integration Token (在 https://www.notion.so/my-integrations 创建)
NOTION_TOKEN=secret_your_token_here

# Notion 数据库 ID (你的选题库/内容日历)
NOTION_CONTENT_DB_ID=your_database_id_here

# ---------- 搜索 & 热点 ----------
# SerpAPI Key (Google 搜索 / 热点抓取)
SERPAPI_KEY=your_key_here

# NewsAPI Key (新闻源)
NEWSAPI_KEY=your_key_here

# ---------- 社交媒体 ----------
# 微信公众号 AppID & Secret (可选)
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# ---------- 图片生成 ----------
# Midjourney (通过 Discord Bot，需配置)
MIDJOURNEY_DISCORD_TOKEN=your_token_here
MIDJOURNEY_CHANNEL_ID=your_channel_id

# ---------- 运行时 ----------
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 数据存储目录
DATA_DIR=./data
